{
    "manifest_version":  3,
    "name":  "Prime Lead Pulse",
    "version":  "1.0.1",
    "description":  "Track email opens and clicks directly inside Gmail.",
    "permissions":  [
                        "storage",
                        "scripting",
                        "notifications",
                        "alarms",
                        "declarativeNetRequest"
                    ],
    "declarative_net_request":  {
                                    "rule_resources":  [
                                                           {
                                                               "id":  "ruleset_1",
                                                               "enabled":  true,
                                                               "path":  "rules.json"
                                                           }
                                                       ]
                                },
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "action":  {
                   "default_popup":  "popup/index.html"
               },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "*://mail.google.com/*"
                                            ],
                                "js":  [
                                           "scripts/content.js"
                                       ],
                                "css":  [
                                            "scripts/content.css"
                                        ],
                                "run_at":  "document_idle"
                            }
                        ],
    "externally_connectable":  {
                                   "matches":  [
                                                   "*://*.vercel.app/*",
                                                   "*://localhost/*"
                                               ]
                               }
}
